diff --git a/src/Unreal.Core/Models/NetFieldHeaderEvent.cs b/src/Unreal.Core/Models/NetFieldHeaderEvent.cs
new file mode 100644
index 0000000..c8a389d
--- /dev/null
+++ b/src/Unreal.Core/Models/NetFieldHeaderEvent.cs
@@ -0,0 +1,44 @@
+namespace Unreal.Core.Models;
+
+/// <summary>
+/// EXPERIMENT HOOK (added for the /tmp/probe3 research harness).
+/// Describes one property header observed inside a single <c>ReceiveProperties</c> call.
+/// A batched RPC payload is a sequence of these (handle, numBits, payload) triples, so
+/// recording the raw header stream is enough to reconstruct per-cue structure without
+/// depending on any particular field being modelled correctly.
+/// </summary>
+public readonly struct NetFieldHeaderEvent
+{
+    /// <summary>PathName of the netfield export group whose payload is being read.</summary>
+    public string GroupPath { get; init; }
+
+    /// <summary>Monotonic id of the enclosing ReceiveProperties call. All headers of one RPC share it.</summary>
+    public long CallId { get; init; }
+
+    /// <summary>True when the enclosing ReceiveProperties call was made from ReceivedRPC (an RPC payload).</summary>
+    public bool IsRpc { get; init; }
+
+    /// <summary>Channel the bunch arrived on. For a NetMulticast damage RPC this is the shooter's pawn channel.</summary>
+    public uint ChannelIndex { get; init; }
+
+    /// <summary>Position in the source archive immediately before the handle was read.</summary>
+    public int HeaderBitOffset { get; init; }
+
+    /// <summary>Zero-based handle (the wire value minus one), i.e. the index into <c>NetFieldExportGroup.NetFieldExports</c>.</summary>
+    public uint Handle { get; init; }
+
+    /// <summary>Export name from the netfield export group, or null when the handle has no export.</summary>
+    public string? ExportName { get; init; }
+
+    /// <summary>Bit length of this property's payload as written on the wire.</summary>
+    public uint NumBits { get; init; }
+
+    /// <summary>Position in the source archive where the payload starts (== HeaderBitOffset + handle/numBits bits).</summary>
+    public int PayloadBitOffset { get; init; }
+
+    /// <summary>True when the payload was skipped rather than parsed (unknown handle or export flagged incompatible).</summary>
+    public bool Skipped { get; init; }
+
+    /// <summary>True when the export is flagged incompatible (either pre-existing or because a previous read failed).</summary>
+    public bool Incompatible { get; init; }
+}
