+namespace Unreal.Core.Models;
+
+/// <summary>
+/// EXPERIMENT HOOK (added for the /tmp/probe3 research harness).
+/// Emitted immediately after a property payload was parsed. Pairs 1:1, in order, with the
+/// non-skipped <see cref="NetFieldHeaderEvent"/>s of the same ReceiveProperties call.
+/// </summary>
+public readonly struct NetFieldValueEvent
+{
+    public string GroupPath { get; init; }
+    public uint ChannelIndex { get; init; }
+    public long CallId { get; init; }
+    public bool IsRpc { get; init; }
+    public uint Handle { get; init; }
+    public string? ExportName { get; init; }
+    public uint NumBits { get; init; }
+    public int BitsConsumed { get; init; }
+    public bool Ok { get; init; }
+    public bool ReaderError { get; init; }
+    public bool PayloadFullyConsumed { get; init; }
+    /// <summary>Reflected value of the property, as a string (null when unavailable).</summary>
+    public string? Value { get; init; }
+}
