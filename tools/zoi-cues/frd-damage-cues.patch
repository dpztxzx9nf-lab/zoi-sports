@@ -0,0 +1,46 @@
+using Unreal.Core.Models;
+
+namespace FortniteReplayReader.Models;
+
+/// <summary>
+/// One <c>NetMulticast_Athena_BatchedDamageCues</c> RPC, attributed to the player whose pawn
+/// channel carried it (that pawn is the instigator/shooter, exactly as in the 2022 fork's
+/// <c>GameInformation.UpdateBatchedDamage</c>).
+/// </summary>
+/// <remarks>
+/// IMPORTANT: this object holds the state left over after the RPC payload has been consumed.
+/// The v7 wire format may pack several cues into a single RPC (repeated handle sequences);
+/// because <see cref="Unreal.Core.NetFieldParser.CreateType"/> hands out one shared, reset
+/// instance per group, only the LAST cue of such a batch survives here. Use the raw header
+/// stream (<c>ReplayReader.OnNetFieldHeader</c>) when per-cue counts are required.
+/// </remarks>
+public class BatchedDamageEvent
+{
+    public uint ChannelIndex { get; init; }
+    public float TimeSeconds { get; init; }
+    public int ReplayDataIndex { get; init; }
+
+    /// <summary>Player that fired, when the pawn channel could be resolved to a PlayerState.</summary>
+    public string? InstigatorName { get; init; }
+    public bool? InstigatorIsReplayOwner { get; init; }
+
+    /// <summary>Player that was hit, when <see cref="HitActor"/> resolved to a known player pawn.</summary>
+    public string? VictimName { get; init; }
+
+    public uint? HitActor { get; init; }
+    public uint? NonPlayerHitActor { get; init; }
+    public FVector Location { get; init; }
+    public FVector Normal { get; init; }
+    public float? Magnitude { get; init; }
+    public float? NonPlayerMagnitude { get; init; }
+    public bool? bWeaponActivate { get; init; }
+    public bool? bIsFatal { get; init; }
+    public bool? bIsCritical { get; init; }
+    public bool? bIsShield { get; init; }
+    public bool? bIsShieldDestroyed { get; init; }
+    public bool? bIsShieldApplied { get; init; }
+    public bool? bIsBallistic { get; init; }
+    public bool? bIsValid { get; init; }
+    public bool? NonPlayerbIsFatal { get; init; }
+    public bool? NonPlayerbIsCritical { get; init; }
+}
